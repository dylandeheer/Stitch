+
+TEST_CASE("Static Vulkan blend keys observe registers even when the dirty bit is clean",
+          "[static_blend_key]") {
+    Fixture f;
+    auto& maxwell = f.fast;
+    Vulkan::DynamicFeatures features{};
+    Vulkan::FixedPipelineState state{};
+    maxwell.regs.color_mask_common = 0;
+    maxwell.regs.blend.enable[3] = 1;
+    maxwell.regs.iterated_blend.enable.Assign(0);
+    maxwell.regs.color_mask[3].R.Assign(1);
+    maxwell.dirty.flags[Vulkan::Dirty::Blending] = true;
+    state.Refresh(maxwell, features);
+    const auto previous = state.attachments[3].raw;
+    const auto sibling = state.attachments[2].raw;
+    maxwell.regs.color_mask[3].R.Assign(0);
+    REQUIRE_FALSE(maxwell.dirty.flags[Vulkan::Dirty::Blending]);
+    state.Refresh(maxwell, features);
+    CHECK(state.attachments[3].mask_r.Value() == 0);
+    CHECK(state.attachments[3].raw != previous);
+    CHECK(state.attachments[2].raw == sibling);
+}
